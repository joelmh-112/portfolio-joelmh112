---
import BrainLayout from "@/layouts/BrainLayout.astro";
import { actions } from 'astro:actions';
import { API_URL } from "astro:env/client";
import type { Category } from "@/types/Category";

const token = Astro.cookies.get("auth_token")?.value;

const categories: Category[] = await fetch(`${API_URL}/categories`, {
    credentials: "include",
    headers: {
        Authorization: token ? `Bearer ${token}` : "",
    },
})
    .then((res) => res.json())
    .catch((err) => {
        console.error("Error fetching categories:", err);
        return [];
    });

console.log("Fetched categories:", categories);

const result = Astro.getActionResult(actions.finance.createCategory);
if (result) {
    if(!result.error) {
        console.log("Category created:", result);
        return Astro.redirect("/brain/finance/allocation");
    } else {
        console.error("Error creating category:", result.error);
    }
}
---

<BrainLayout title="Gestión de categorías">
  <div class="p-10 max-w-2xl mx-auto">
    <h2 class="text-3xl font-oswald text-primary mb-6">Categorías de transacciones</h2>
    <div id="categories-list" class="flex flex-col gap-4 mb-8">
      {categories.length > 0 ? (
        categories.map((category) => (
          <div class="bg-gray-900 bg-opacity-80 p-4 rounded-lg shadow-md flex justify-between items-center">
            <span class="text-white font-oswald">{category.name}</span>
            <span class="text-primary font-bold">{category.percentage}%</span>
          </div>
        ))
      ) : (
        <p class="text-gray-500">Aún no existen categorías</p>
      )}
    </div>
    <div class="bg-gray-900 bg-opacity-80 p-6 rounded-lg shadow-md">
      <h3 class="text-xl font-oswald text-primary mb-4">Crear nueva categoría</h3>
      <form id="create-category-form" class="flex flex-col gap-4" method="POST" action={actions.finance.createCategory}>
        <input type="text" name="name" placeholder="Nombre" class="px-4 py-2 rounded bg-gray-800 text-white" required />
        <input type="number" name="percentage" placeholder="Porcentaje" min="0" max="100" class="px-4 py-2 rounded bg-gray-800 text-white" required />
        <button type="submit" class="bg-primary text-white px-4 py-2 rounded font-semibold">Crear</button>
      </form>
    </div>
</BrainLayout>
